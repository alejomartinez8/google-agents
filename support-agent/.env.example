# Local development configuration
# For deployment, these are set via Terraform / the deploy command.

# Vertex AI Configuration (default)
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio,
# comment out the three lines above and uncomment:
# GEMINI_API_KEY=your-api-key-here

# --- Specific to this agent (DevSecOps Incident Triage / GENAI162) ---
# Model used by every Agent() in the workflow (coordinator, search_vais_agent,
# internal_analyst, web_search_agent, mcp_kb_agent, synthesis_agent)
MODEL=gemini-2.5-flash

# BigQuery table with pre-loaded incident post-mortems + vector embeddings
# (description_embedding column, text-embedding-004). Requires its own setup,
# ver referencia en wiki/sources/build-agents-with-adk.md
BIGQUERY_DATASET=ops_intelligence
BIGQUERY_TABLE=incident_post_mortems

# Vertex AI Search (Agent Search) datastore with the internal runbooks indexed
DATASTORE_LOCATION=us
DATASTORE_ID=your-datastore-id

# MCP server registered in Agent Registry (Agent Platform > Agents > Agent
# Registry > MCP Servers). En el lab original era un server de demo de
# Qwiklabs (developerknowledge.googleapis.com) — sin confirmar si está
# accesible fuera de ese entorno efímero.
MCP_SERVER_LOCATION=global
MCP_SERVER_NAME=agentregistry-your-mcp-server-name
